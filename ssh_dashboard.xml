<form version="1.1" theme="dark">
  <label>ssh_dashboard</label>
  <fieldset submitButton="true">
    <input type="time" token="time_range">
      <label>Time Range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <single>
        <title>Succesfull login</title>
        <search>
          <query>source="ssh_logs_new.zip:*" host="MAEEZPATEL"  sourcetype="json-2"  event_type="Successful SSH Login" 
| stats count AS "Successful Logins"</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="rangeColors">["0x53a051","0x0877a6","0xf8be34","0xf1813f","0xdc4e41"]</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Failed logins</title>
        <search>
          <query>source="ssh_logs_new.zip:*" host="MAEEZPATEL"  sourcetype="json-2"   event_type="Failed SSH Login"
| stats count AS "Failed Login"</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Invalid User Attempts</title>
        <search>
          <query>source="ssh_logs_new.zip:*" host="MAEEZPATEL"  sourcetype="json-2"   event_type="Connection without Authentication"
| stats count AS "Connection without Authentication"</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Failed Logins By Username</title>
        <search>
          <query>source="ssh_logs_new.zip:*" host="MAEEZPATEL"  sourcetype="json-2"   event_type="Failed SSH Login" | top username</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <table>
        <title>Possible brute force</title>
        <search>
          <query>source="ssh_logs_new.zip:*" host="MAEEZPATEL"  sourcetype="json-2" event_type="Multiple Failed Authentication Attempts" | top id.orig_h</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
    <panel>
      <map>
        <title>Brute Force attack with geo-location</title>
        <search>
          <query>source="ssh_logs_new.zip:*" host="MAEEZPATEL"  sourcetype="json-2" event_type="Multiple Failed Authentication Attempts" 
| table id.orig_h
| iplocation id.orig_h
| stats count by Country
| geom geo_countries featureIdField="Country"</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="mapping.type">choropleth</option>
      </map>
    </panel>
  </row>
</form>
